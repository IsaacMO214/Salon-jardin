# ─── MySQL Database (required) ───
# Create the database first: mysql -u root -p -e "CREATE DATABASE jardin_fantasy"
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jardin_fantasy

# ─── Usuario administrador (para scripts/create-admin.js) ───
# Usuario y contraseña con los que entrarás al panel de administración (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# ─── CORS — Orígenes permitidos (producción) ───
# URL de tu frontend en Hostinger (separar múltiples con coma)
# ALLOWED_ORIGINS=https://tu-subdominio.hostingersite.com

# ─── Cloudinary (producción — para subida de archivos) ───
# Crear cuenta gratis en https://cloudinary.com
# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=tu-api-key
# CLOUDINARY_API_SECRET=tu-api-secret

# ─── HTTPS / SSL (optional) ───
# Path to your SSL certificate files. If empty, server falls back to HTTP.
# SSL_KEY_PATH=./ssl/key.pem
# SSL_CERT_PATH=./ssl/cert.pem
